--- a/drivers/serial/serial_mxc.c
+++ b/drivers/serial/serial_mxc.c
@@ -14,6 +14,7 @@
 #include <serial.h>
 #include <linux/compiler.h>
 #include <linux/delay.h>
+#include <linux/rational.h>
 
 /* UART Control Register Bit Fields.*/
 #define URXD_CHARRDY	(1<<15)
@@ -182,6 +183,7 @@
 static void _mxc_serial_setbrg(struct mxc_uart *base, unsigned long clk,
 			       unsigned long baudrate, bool use_dte)
 {
+	unsigned long num, denom;
 	u32 tmp;
 
 	_mxc_serial_flush(base);
@@ -193,8 +195,11 @@
 		tmp |= (TXTL << UFCR_TXTL_SHF) | (RXTL << UFCR_RXTL_SHF);
 	writel(tmp, &base->fcr);
 
-	writel(0xf, &base->bir);
-	writel(clk / (2 * baudrate), &base->bmr);
+	/* RFDIV is 2; UBIR and UBMR store numerator/denominator minus one. */
+	rational_best_approximation(16 * baudrate, clk / 2,
+				    0x10000, 0x10000, &num, &denom);
+	writel(num - 1, &base->bir);
+	writel(denom - 1, &base->bmr);
 
 	writel(UCR2_WS | UCR2_IRTS | UCR2_RXEN | UCR2_TXEN | UCR2_SRST,
 	       &base->cr2);
