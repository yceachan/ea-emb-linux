+/* Read-only gate for the unlink/create writer's metadata limitations. */
+int ext4fs_file_writable(const char *path)
+{
+	struct ext_filesystem *fs = get_fs();
+	struct ext2_sblock *sb = &ext4fs_root->sblock;
+	u32 incompat = le32_to_cpu(sb->feature_incompat);
+	struct ext2_inode *inode;
+	loff_t bytes;
+	unsigned int extra;
+	int ret = -1;
+
+	/* Reject before ext4fs_init can replay or change the journal. */
+	if (le32_to_cpu(sb->log2_block_size) != 2 ||
+	    le16_to_cpu(sb->fs_state) != 1 ||
+	    !(le32_to_cpu(sb->feature_compatibility) & 4) ||
+	    (incompat & EXT4_FEATURE_INCOMPAT_RECOVER) ||
+	    (incompat & ~EXT4_FEATURE_INCOMPAT_SUPP) ||
+	    (le32_to_cpu(sb->feature_ro_compat) & ~EXT4_FEATURE_RO_COMPAT_SUPP))
+		return -1;
+	if (ext4fs_open(path, &bytes) || ext4fs_io_error || symlinknest ||
+	    !ext4fs_file || fs->inodesz < 128 || fs->inodesz > 4096)
+		return -1;
+	inode = zalloc(fs->inodesz);
+	if (!inode)
+		return -1;
+	if (!ext4fs_read_inode_full(ext4fs_root, ext4fs_file->ino, inode) ||
+	    ext4fs_io_error || le16_to_cpu(inode->nlinks) != 1 ||
+	    (le16_to_cpu(inode->mode) & FILETYPE_INO_MASK) != FILETYPE_INO_REG ||
+	    inode->acl || (le32_to_cpu(inode->osd2[0]) >> 16) ||
+	    (le32_to_cpu(inode->flags) & ~0x80000U))
+		goto out;
+	/* The unlink writer does not free extent index blocks. */
+	if ((le32_to_cpu(inode->flags) & EXT4_EXTENTS_FL) &&
+	    le16_to_cpu(((struct ext4_extent_header *)inode->b.blocks.dir_blocks)->eh_depth))
+		goto out;
+	if (fs->inodesz > 128) {
+		extra = le16_to_cpu(*(__le16 *)((u8 *)inode + 128));
+		if (extra > fs->inodesz - 128 || (extra && (extra < 4 || extra % 4)))
+			goto out;
+		if (fs->inodesz - 128 - extra >= 4 &&
+		    le32_to_cpu(*(__le32 *)((u8 *)inode + 128 + extra)) == 0xea020000)
+			goto out;
+	}
+	ret = 0;
+out:
+	free(inode);
+	return ret;
+}
