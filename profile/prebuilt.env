# 在 Bash 或 Zsh 中加载：source /home/pi/ea-emb-linux/profile/prebuilt.env
# 本文件不设置 CFLAGS、CXXFLAGS 或 LDFLAGS。

export ARCH=arm
export CROSS_COMPILE=/home/pi/ea-emb-linux/sdk/vendor_mainline/toolchains/arm-gnu-toolchain-15.3.rel1-x86_64-arm-none-linux-gnueabihf/bin/arm-none-linux-gnueabihf-
export CC="${CROSS_COMPILE}gcc"
export CXX="${CROSS_COMPILE}g++"

if [ ! -x "$CC" ] || [ ! -x "$CXX" ]; then
    printf '交叉 GCC 或 G++ 不存在或不可执行：%s\n' "${CROSS_COMPILE%/*}" >&2
    return 1
fi

# Make 在主机上运行，不使用交叉前缀。
command -v make >/dev/null || {
    printf '主机 Make 不在 PATH 中\n' >&2
    return 1
}

# 重复加载时，不向 PATH 重复添加同一目录。
case ":$PATH:" in
    *":${CROSS_COMPILE%/*}:"*) ;;
    *) export PATH="${CROSS_COMPILE%/*}:$PATH" ;;
esac

# 查看导出的环境变量。
dump_toolchain_env() {
    printf '%s\n' \
        "ARCH=$ARCH" \
        "CROSS_COMPILE=$CROSS_COMPILE" \
        "CC=$CC" "CXX=$CXX"
}

# 查看交叉 GCC、交叉 G++ 和主机 Make 的版本。
dump_toolchain_versions() {
    "$CC" --version || return
    "$CXX" --version || return
    command make --version
}

# 汇总环境与三个构建组件的版本。
dump_toolchain() {
    dump_toolchain_env || return
    dump_toolchain_versions
}
